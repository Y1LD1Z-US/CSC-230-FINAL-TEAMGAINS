type DataRow = Record<string, string | number | null | undefined>;
type ChartType = "line" | "bar" | "pie" | "histogram" | "scatter";

function isNumericArray(arr: any[]): arr is number[] {
  return arr.every((v) => typeof v === "number" && Number.isFinite(v));
}

function toNumber(value: unknown): number | null {
  if (value === null || value === undefined) return null;
  const n = typeof value === "number" ? value : Number(String(value).trim());
  return Number.isFinite(n) ? n : null;
}

function unique<T>(arr: T[]): T[] {
  return Array.from(new Set(arr));
}

function fdBinCount(values: number[]): number {
  if (values.length < 2) return Math.max(1, values.length);
  const sorted = [...values].sort((a, b) => a - b);
  const q1 = sorted[Math.floor(0.25 * (sorted.length - 1))];
  const q3 = sorted[Math.floor(0.75 * (sorted.length - 1))];
  const iqr = q3 - q1 || (sorted[sorted.length - 1] - sorted[0]) / 2 || 1;
  const h = (2 * iqr) / Math.cbrt(values.length);
  const min = sorted[0];
  const max = sorted[sorted.length - 1];
  const bins = Math.max(1, Math.ceil((max - min) / (h || 1)));
  return Math.min(60, Math.max(5, bins));
}

function linearRegression(xVals: number[], yVals: number[]) {
  const n = xVals.length;
  const mean = (a: number[]) => a.reduce((s, v) => s + v, 0) / a.length;
  const mx = mean(xVals);
  const my = mean(yVals);
  let num = 0;
  let den = 0;
  for (let i = 0; i < n; i++) {
    const dx = xVals[i] - mx;
    const dy = yVals[i] - my;
    num += dx * dy;
    den += dx * dx;
  }
  const b = den === 0 ? 0 : num / den;
  const a = my - b * mx;
  const ssTot = yVals.reduce((s, y) => s + Math.pow(y - my, 2), 0);
  const ssRes = yVals.reduce((s, y, i) => s + Math.pow(y - (a + b * xVals[i]), 2), 0);
  const r2 = ssTot === 0 ? 1 : 1 - ssRes / ssTot;
  const s2 = ssRes / (n - 2);
  const sx2 = den;
  const se_b = Math.sqrt(s2 / sx2);
  return { a, b, r2, se_b };
}

export default function RStyleCharts() {
  const [raw, setRaw] = useState<DataRow[]>([]);
  const [chartType, setChartType] = useState<ChartType>("scatter");
  const [xKey, setXKey] = useState<string>("");
  const [yKey, setYKey] = useState<string>("");
  const [catKey, setCatKey] = useState<string>("");
  const [valKey, setValKey] = useState<string>("");
