import React, { useMemo, useState } from "react";
import Papa from "papaparse";
import {
  LineChart,
  Line,
  BarChart,
  Bar,
  PieChart,
  Pie,
  Cell,
  ScatterChart,
  Scatter,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  Legend,
  ResponsiveContainer
} from "recharts";
import { motion } from "framer-motion";

function toNumber(value) {
  if (value === null || value === undefined) return null;
  const n = typeof value === "number" ? value : Number(String(value).trim());
  return Number.isFinite(n) ? n : null;
}

function fdBinCount(values) {
  if (values.length < 2) return Math.max(1, values.length);
  const sorted = [...values].sort((a, b) => a - b);
  const q1 = sorted[Math.floor(0.25 * (sorted.length - 1))];
  const q3 = sorted[Math.floor(0.75 * (sorted.length - 1))];
  const iqr = q3 - q1 || (sorted[sorted.length - 1] - sorted[0]) / 2 || 1;
  const h = (2 * iqr) / Math.cbrt(values.length);
  const min = sorted[0];
  const max = sorted[sorted.length - 1];
  const bins = Math.max(1, Math.ceil((max - min) / (h || 1)));
  return Math.min(60, Math.max(5, bins));
}

function linearRegression(xVals, yVals) {
  const n = Math.min(xVals.length, yVals.length);
  if (n < 2) return null;

  const mean = (a) => a.reduce((s, v) => s + v, 0) / a.length;
  const mx = mean(xVals);
  const my = mean(yVals);
  let num = 0;
  let den = 0;
  for (let i = 0; i < n; i++) {
    const dx = xVals[i] - mx;
    const dy = yVals[i] - my;
    num += dx * dy;
    den += dx * dx;
  }
  const b = den === 0 ? 0 : num / den;
  const a = my - b * mx;

  const ssTot = yVals.reduce((s, y) => s + Math.pow(y - my, 2), 0);
  const ssRes = yVals.reduce((s, y, i) => s + Math.pow(y - (a + b * xVals[i]), 2), 0);
  const r2 = ssTot === 0 ? 1 : 1 - ssRes / ssTot;

  const s2 = n > 2 ? ssRes / (n - 2) : 0;
  const sx2 = den || 1;
  const se_b = Math.sqrt(s2 / sx2);

  return { a, b, r2, se_b };
}

export default function RStyleCharts() {
  const [raw, setRaw] = useState([]);
  const [chartType, setChartType] = useState("scatter");
  const [xKey, setXKey] = useState("");
  const [yKey, setYKey] = useState("");
  const [catKey, setCatKey] = useState("");
  const [valKey, setValKey] = useState("");
  const [binCount, setBinCount] = useState(undefined);
  const [showRegression, setShowRegression] = useState(true);

  const columns = useMemo(() => (raw[0] ? Object.keys(raw[0]) : []), [raw]);

  const numericCols = useMemo(() => {
    if (!raw.length) return [];
    return columns.filter((key) => raw.some((row) => toNumber(row[key]) !== null));
  }, [raw, columns]);

  const { xVec, yVec } = useMemo(() => {
    if (!xKey || !yKey) return { xVec: [], yVec: [] };
    const xVals = raw.map((r) => toNumber(r[xKey])).filter((v) => v !== null);
    const yVals = raw.map((r) => toNumber(r[yKey])).filter((v) => v !== null);
    const len = Math.min(xVals.length, yVals.length);
    return { xVec: xVals.slice(0, len), yVec: yVals.slice(0, len) };
  }, [raw, xKey, yKey]);

  const reg = useMemo(() => {
    if (!xVec.length || !yVec.length) return null;
    return linearRegression(xVec, yVec);
  }, [xVec, yVec]);

  const scatterData = useMemo(() => {
    if (!xKey || !yKey) return [];
    return raw
      .map((r) => ({ x: toNumber(r[xKey]), y: toNumber(r[yKey]) }))
      .filter((d) => d.x !== null && d.y !== null);
  }, [raw, xKey, yKey]);

  const lineBarData = useMemo(() => {
    if (!xKey || !yKey) return [];
    return raw
      .map((r, idx) => ({
        index: idx,
        x: toNumber(r[xKey]) ?? r[xKey],
        y: toNumber(r[yKey])
      }))
      .filter((d) => d.y !== null);
  }, [raw, xKey, yKey]);

  const pieData = useMemo(() => {
    if (!catKey || !valKey) return [];
    const map = new Map();
    for (const r of raw) {
      const k = String(r[catKey] ?? "(missing)");
      const v = toNumber(r[valKey]) ?? 0;
      map.set(k, (map.get(k) ?? 0) + v);
    }
    return Array.from(map.entries()).map(([name, value]) => ({ name, value }));
  }, [raw, catKey, valKey]);

  const histData = useMemo(() => {
    if (!valKey) return [];
    const values = raw.map((r) => toNumber(r[valKey])).filter((v) => v !== null);
    if (!values.length) return [];
    const bins = binCount ?? fdBinCount(values);
    const min = Math.min(...values);
    const max = Math.max(...values);
    const width = (max - min) / bins || 1;
    const counts = Array.from({ length: bins }, () => 0);
    for (const v of values) {
      let idx = Math.floor((v - min) / width);
      if (idx >= bins) idx = bins - 1;
      counts[idx]++;
    }
    return counts.map((c, i) => ({
      bin: `${(min + i * width).toFixed(2)}–${(min + (i + 1) * width).toFixed(2)}`,
      count: c
    }));
  }, [raw, valKey, binCount]);

  const regressionLine = useMemo(() => {
    if (!reg || !scatterData.length) return [];
    const xs = scatterData.map((d) => d.x);
    const minX = Math.min(...xs);
    const maxX = Math.max(...xs);
    return [
      { x: minX, y: reg.a + reg.b * minX },
      { x: maxX, y: reg.a + reg.b * maxX }
    ];
  }, [reg, scatterData]);

  function handleCSV(file) {
    Papa.parse(file, {
      header: true,
      dynamicTyping: true,
      skipEmptyLines: true,
      complete: (res) => {
        const rows = res.data.filter((r) => Object.keys(r).length > 0);
        setRaw(rows);
        const keys = rows[0] ? Object.keys(rows[0]) : [];
        setXKey(keys[0] ?? "");
        setYKey(keys[1] ?? keys[0] ?? "");
        setCatKey(keys[0] ?? "");
        setValKey(keys[1] ?? "");
      }
    });
  }

  const colorRamp = useMemo(
    () => [
      "#4c78a8", "#f58518", "#e45756", "#72b7b2", "#54a24b",
      "#eeca3b", "#b279a2", "#ff9da6", "#9d755d", "#bab0ac"
    ],
    []
  );

  return (
    <div className="min-h-screen w-full bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100">
      <div className="max-w-6xl mx-auto px-4 py-8">
        <motion.h1
          initial={{ opacity: 0, y: -8 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.4 }}
          className="text-3xl font-bold tracking-tight"
        >
          GAINS – R-Style Graphics & Linear Regression
        </motion.h1>

        <p className="mt-2 text-sm text-zinc-600 dark:text-zinc-300">
          Upload a CSV and build Line, Bar, Pie, Histogram, or Scatter plots. Optional simple
          linear regression overlays the best-fit line with R².
        </p>

        <div className="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800">
            <label className="text-sm font-medium">Upload CSV</label>
            <input
              type="file"
              accept=".csv,text/csv"
              onChange={(e) => {
                const f = e.target.files?.[0];
                if (f) handleCSV(f);
              }}
              className="mt-2 block w-full text-sm"
            />
            {raw.length > 0 && (
              <p className="mt-2 text-xs text-zinc-500">
                Loaded <span className="font-semibold">{raw.length}</span> rows · {columns.length} columns
              </p>
            )}
          </div>

          <div className="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800">
            <label className="text-sm font-medium">Chart Type</label>
            <select
              value={chartType}
              onChange={(e) => setChartType(e.target.value)}
              className="mt-2 w-full rounded-xl bg-transparent border border-zinc-300 dark:border-zinc-700 px-3 py-2 text-sm"
            >
              <option value="scatter">Scatter (for regression)</option>
              <option value="line">Line</option>
              <option value="bar">Bar</option>
              <option value="pie">Pie</option>
              <option value="histogram">Histogram</option>
            </select>

            {chartType === "scatter" && (
              <div className="mt-3 space-y-2">
                <div>
                  <label className="text-xs">X (numeric)</label>
                  <select
                    value={xKey}
                    onChange={(e) => setXKey(e.target.value)}
                    className="mt-1 w-full rounded-xl bg-transparent border border-zinc-300 dark:border-zinc-700 px-3 py-2 text-sm"
                  >
                    {columns.map((c) => (
                      <option key={c} value={c}>{c}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="text-xs">Y (numeric)</label>
                  <select
                    value={yKey}
                    onChange={(e) => setYKey(e.target.value)}
                    className="mt-1 w-full rounded-xl bg-transparent border border-zinc-300 dark:border-zinc-700 px-3 py-2 text-sm"
                  >
                    {columns.map((c) => (
                      <option key={c} value={c}>{c}</option>
                    ))}
                  </select>
                </div>
                <div className="flex items-center gap-2 pt-1">
                  <input id="reg" type="checkbox" checked={showRegression} onChange={(e) => setShowRegression(e.target.checked)} />
                  <label htmlFor="reg" className="text-xs">Show linear regression</label>
                </div>
              </div>
            )}

            {(chartType === "line" || chartType === "bar") && (
              <div className="mt-3 space-y-2">
                <div>
                  <label className="text-xs">X (categorical or numeric)</label>
                  <select
                    value={xKey}
                    onChange={(e) => setXKey(e.target.value)}
                    className="mt-1 w-full rounded-xl bg-transparent border border-zinc-300 dark:border-zinc-700 px-3 py-2 text-sm"
                  >
                    {columns.map((c) => (
                      <option key={c} value={c}>{c}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="text-xs">Y (numeric)</label>
                  <select
                    value={yKey}
                    onChange={(e) => setYKey(e.target.value)}
                    className="mt-1 w-full rounded-xl bg-transparent border border-zinc-300 dark:border-zinc-700 px-3 py-2 text-sm"
                  >
                    {numericCols.map((c) => (
                      <option key={c} value={c}>{c}</option>
                    ))}
                  </select>
                </div>
              </div>
            )}

            {chartType === "pie" && (
              <div className="mt-3 space-y-2">
                <div>
                  <label className="text-xs">Category</label>
                  <select
                    value={catKey}
                    onChange={(e) => setCatKey(e.target.value)}
                    className="mt-1 w-full rounded-xl bg-transparent border border-zinc-300 dark:border-zinc-700 px-3 py-2 text-sm"
                  >
                    {columns.map((c) => (
                      <option key={c} value={c}>{c}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="text-xs">Value (numeric)</label>
                  <select
                    value={valKey}
                    onChange={(e) => setValKey(e.target.value)}
                    className="mt-1 w-full rounded-xl bg-transparent border border-zinc-300 dark:border-zinc-700 px-3 py-2 text-sm"
                  >
                    {numericCols.map((c) => (
                      <option key={c} value={c}>{c}</option>
                    ))}
                  </select>
                </div>
              </div>
            )}

            {chartType === "histogram" && (
              <div className="mt-3 space-y-2">
                <div>
                  <label className="text-xs">Value (numeric)</label>
                  <select
                    value={valKey}
                    onChange={(e) => setValKey(e.target.value)}
                    className="mt-1 w-full rounded-xl bg-transparent border border-zinc-300 dark:border-zinc-700 px-3 py-2 text-sm"
                  >
                    {numericCols.map((c) => (
                      <option key={c} value={c}>{c}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="text-xs">Bins (optional)</label>
                  <input
                    type="number"
                    min={1}
                    max={100}
                    value={binCount ?? ""}
                    onChange={(e) => {
                      const v = e.target.value;
                      setBinCount(v === "" ? undefined : Math.max(1, Math.min(100, Number(v))));
                    }}
                    className="mt-1 w-full rounded-xl bg-transparent border border-zinc-300 dark:border-zinc-700 px-3 py-2 text-sm"
                    placeholder="Auto"
                  />
                </div>
              </div>
            )}
          </div>

          <div className="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800">
            <div className="text-sm font-medium">Status</div>
            <ul className="mt-2 text-xs space-y-1 text-zinc-600 dark:text-zinc-300">
              <li>Rows: <span className="font-semibold">{raw.length}</span></li>
              <li>Columns: <span className="font-semibold">{columns.length}</span></li>
              {reg && chartType === "scatter" && showRegression && (
                <li>R²: <span className="font-semibold">{reg.r2.toFixed(4)}</span></li>
              )}
            </ul>
          </div>
        </div>

        <div className="mt-6 h-[420px] rounded-2xl border border-zinc-200 dark:border-zinc-800 p-3">
          {chartType === "scatter" && scatterData.length > 0 && (
            <ResponsiveContainer width="100%" height="100%">
              <ScatterChart>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="x" type="number" name={xKey || "x"} />
                <YAxis dataKey="y" type="number" name={yKey || "y"} />
                <Tooltip />
                <Legend />
                <Scatter name="Data" data={scatterData} />
                {showRegression && reg && (
                  <Line
                    name={`Fit (R²=${reg.r2.toFixed(3)})`}
                    type="linear"
                    data={regressionLine}
                    dataKey="y"
                    dot={false}
                    strokeDasharray="6 4"
                  />
                )}
              </ScatterChart>
            </ResponsiveContainer>
          )}

          {chartType === "line" && lineBarData.length > 0 && (
            <ResponsiveContainer width="100%" height="100%">
              <LineChart data={lineBarData}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="x" />
                <YAxis />
                <Tooltip />
                <Legend />
                <Line type="monotone" dataKey="y" name={yKey || "y"} />
              </LineChart>
            </ResponsiveContainer>
          )}

          {chartType === "bar" && lineBarData.length > 0 && (
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={lineBarData}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="x" />
                <YAxis />
                <Tooltip />
                <Legend />
                <Bar dataKey="y" name={yKey || "y"} />
              </BarChart>
            </ResponsiveContainer>
          )}

          {chartType === "pie" && pieData.length > 0 && (
            <ResponsiveContainer width="100%" height="100%">
              <PieChart>
                <Tooltip />
                <Legend />
                <Pie data={pieData} dataKey="value" nameKey="name" outerRadius="80%">
                  {pieData.map((_, i) => (
                    <Cell key={i} fill={colorRamp[i % colorRamp.length]} />
                  ))}
                </Pie>
              </PieChart>
            </ResponsiveContainer>
          )}

          {chartType === "histogram" && histData.length > 0 && (
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={histData}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="bin" />
                <YAxis />
                <Tooltip />
                <Legend />
                <Bar dataKey="count" name="Count" />
              </BarChart>
            </ResponsiveContainer>
          )}

          {(chartType === "scatter" && scatterData.length === 0) ||
          ((chartType === "line" || chartType === "bar") && lineBarData.length === 0) ||
          (chartType === "pie" && pieData.length === 0) ||
          (chartType === "histogram" && histData.length === 0) ? (
            <div className="w-full h-full flex items-center justify-center text-sm text-zinc-500">
              Upload a CSV and select columns to visualize.
            </div>
          ) : null}
        </div>
      </div>
    </div>
  );
}
